{
  "name": "tools",
  "mode": "auto",
  "budget": 220,
  "what": "Tool calling beyond film: generate, cut out, music, animate, subtitle, write, check",
  "steps": [
    {
      "do": "import",
      "from": "runs/topgun9/refs/vega-f35c-3.jpg",
      "name": "jet.jpg"
    },
    {
      "do": "import",
      "from": "runs/topgun9/clips/seq-12-12.mp4",
      "name": "clip.mp4"
    },
    {
      "do": "send",
      "text": "A picture of a lighthouse at dawn, painterly, 16:9.",
      "expect": {
        "tools": [
          "image"
        ],
        "credits_max": 5
      }
    },
    {
      "do": "run"
    },
    {
      "do": "send",
      "text": "Cut the jet out of this photo, transparent background.",
      "materials": [
        "jet.jpg"
      ],
      "expect": {
        "tools": [
          "background-remove"
        ],
        "credits_max": 5
      }
    },
    {
      "do": "run"
    },
    {
      "do": "send",
      "text": "A 15-second calm piano music bed.",
      "expect": {
        "tools": [
          "music"
        ],
        "credits_max": 15
      }
    },
    {
      "do": "run"
    },
    {
      "do": "send",
      "text": "Animate the lighthouse picture for 5 seconds, slow waves, the beam turning.",
      "expect": {
        "tools": [
          "image-to-video"
        ],
        "credits_max": 125
      }
    },
    {
      "do": "run"
    },
    {
      "do": "send",
      "text": "Add subtitles to this clip.",
      "materials": [
        "clip.mp4"
      ],
      "expect": {
        "tools": [
          "captions"
        ],
        "credits_max": 15
      }
    },
    {
      "do": "run"
    },
    {
      "do": "send",
      "text": "Write an Instagram caption for the lighthouse picture, under 120 characters, two hashtags.",
      "expect": {
        "tools": [
          "write"
        ],
        "credits_max": 0
      }
    },
    {
      "do": "run"
    },
    {
      "do": "send",
      "text": "Check whether the lighthouse picture actually shows a lighthouse at dawn.",
      "expect": {
        "tools": [
          "check"
        ],
        "credits_max": 0
      }
    },
    {
      "do": "run"
    }
  ]
}